<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_StudentProjectApproval"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.50.1"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.9.0">

  <bpmn:collaboration id="Collaboration_StudentProject">
    <bpmn:participant id="Participant_StudentProjectProcess" name="Student Project Approval &amp; Allocation System" processRef="Process_StudentProjectApproval" />
  </bpmn:collaboration>

  <bpmn:process id="Process_StudentProjectApproval" name="Student Project Approval &amp; Allocation System" isExecutable="true">
    
    <!-- Lanes Definition -->
    <bpmn:laneSet id="LaneSet_StudentProject">
      <bpmn:lane id="Lane_Student" name="Student / Team">
        <bpmn:flowNodeRef>StartEvent_ProposalSubmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ResubmitProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ModifyTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_InvalidTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RejectedPlagiarism</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RejectedCommittee</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Coordinator" name="Project Coordinator">
        <bpmn:flowNodeRef>UserTask_ScreenProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ReviewPlagiarismMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ManualGuideAllocation</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Committee" name="Review Committee (incl. HoD)">
        <bpmn:flowNodeRef>UserTask_EvaluateProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_RevisionLoop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CommitteeDecision</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Guide" name="Faculty Guide">
        <bpmn:flowNodeRef>UserTask_GuideResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryTimer_GuideResponseTimeout</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_System" name="Project Management System">
        <bpmn:flowNodeRef>ServiceTask_ValidateFormAndRules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValidationPassed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValidationAttempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CheckDuplicateTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DuplicateCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BusinessRuleTask_CheckGuideAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GuideAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_AllocateGuide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_SendAllocationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_NotifyStudentAndRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProjectAllocated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_AllocationFinalization</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ProposalSubmitted" name="Project Proposal Submitted">
      <bpmn:outgoing>Flow_StartToValidate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Step 1 & 2: Form & Team Rule Validation -->
    <bpmn:serviceTask id="ServiceTask_ValidateFormAndRules" name="Validate Form Completeness &amp; Team Rules">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-proposal" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToValidate</bpmn:incoming>
      <bpmn:incoming>Flow_ResubmitToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateToGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_ValidationPassed" name="Validation Passed?">
      <bpmn:incoming>Flow_ValidateToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidationYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidationNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Failure Path F1 & F2: Validation & Team Rule Check -->
    <bpmn:exclusiveGateway id="Gateway_ValidationAttempts" name="Attempt Limit Reached? (&gt;2)">
      <bpmn:incoming>Flow_ValidationNo</bpmn:incoming>
      <bpmn:outgoing>Flow_AttemptUnderLimit</bpmn:outgoing>
      <bpmn:outgoing>Flow_AttemptExceeded</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_ResubmitProposal" name="Resubmit Proposal Form (F1: Correction)">
      <bpmn:incoming>Flow_AttemptUnderLimit</bpmn:incoming>
      <bpmn:outgoing>Flow_ResubmitToValidate</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_InvalidTeam" name="End: Proposal Rejected (F2: Invalid Team / Exceeded Attempts)">
      <bpmn:incoming>Flow_AttemptExceeded</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_InvalidTeam" errorRef="Error_InvalidTeam" />
    </bpmn:endEvent>

    <!-- Step 3 & 4: Duplicate & Similarity Check -->
    <bpmn:serviceTask id="ServiceTask_CheckDuplicateTopic" name="Run Similarity &amp; Duplicate Topic Check">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-similarity" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidationYes</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckToGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_DuplicateCheck" name="Similarity Above Threshold?">
      <bpmn:incoming>Flow_CheckToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PlagiarismNo</bpmn:outgoing>
      <bpmn:outgoing>Flow_PlagiarismYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Failure Path F3: Duplicate / Plagiarised Topic -->
    <bpmn:userTask id="UserTask_ReviewPlagiarismMatch" name="Review Plagiarism Match (F3)">
      <bpmn:incoming>Flow_PlagiarismYes</bpmn:incoming>
      <bpmn:outgoing>Flow_MatchToDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_ModifyTopic" name="Modify Topic &amp; Proposal">
      <bpmn:incoming>Flow_MatchToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_TopicModifiedToScreen</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_RejectedPlagiarism" name="End: Rejected (Plagiarism)">
      <bpmn:incoming>Flow_PlagiarismReject</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Step 5: Coordinator Screening -->
    <bpmn:userTask id="UserTask_ScreenProposal" name="Screen Proposal &amp; Check Deadlines">
      <bpmn:incoming>Flow_PlagiarismNo</bpmn:incoming>
      <bpmn:incoming>Flow_TopicModifiedToScreen</bpmn:incoming>
      <bpmn:outgoing>Flow_ScreenToCommittee</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Step 6: Committee Evaluation -->
    <bpmn:userTask id="UserTask_EvaluateProposal" name="Evaluate Proposal (Review Committee)">
      <bpmn:incoming>Flow_ScreenToCommittee</bpmn:incoming>
      <bpmn:outgoing>Flow_EvaluateToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Step 7: Gateway Committee Decision -->
    <bpmn:exclusiveGateway id="Gateway_CommitteeDecision" name="Committee Decision?">
      <bpmn:incoming>Flow_EvaluateToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Revise</bpmn:outgoing>
      <bpmn:outgoing>Flow_RejectCommittee</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Failure Path F5: Revision Loop Sub-process -->
    <bpmn:subProcess id="SubProcess_RevisionLoop" name="7-Day Revision Loop (F5: Max 2 Cycles)">
      <bpmn:incoming>Flow_Revise</bpmn:incoming>
      <bpmn:outgoing>Flow_RevisionCompleted</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Failure Path F6: Committee Rejection -->
    <bpmn:endEvent id="EndEvent_RejectedCommittee" name="End: Proposal Rejected (Committee)">
      <bpmn:incoming>Flow_RejectCommittee</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Step 8: Guide Availability & Workload Check -->
    <bpmn:businessRuleTask id="BusinessRuleTask_CheckGuideAvailability" name="Check Guide Availability &amp; Workload DMN">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="guide_allocation_rules" resultVariable="guideAvailable" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:incoming>Flow_RevisionCompleted</bpmn:incoming>
      <bpmn:outgoing>Flow_RuleToGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <!-- Failure Path F8: No Guide Available -->
    <bpmn:exclusiveGateway id="Gateway_GuideAvailable" name="Guide Available?">
      <bpmn:incoming>Flow_RuleToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_GuideFound</bpmn:outgoing>
      <bpmn:outgoing>Flow_GuideNone</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_ManualGuideAllocation" name="Manual Guide / Co-Guide Allocation (F8)">
      <bpmn:incoming>Flow_GuideNone</bpmn:incoming>
      <bpmn:incoming>Flow_GuideTimeout</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualGuideAssigned</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Step 9: Allocate & Request Guide Acceptance -->
    <bpmn:serviceTask id="ServiceTask_AllocateGuide" name="Allocate Faculty Guide">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="allocate-guide" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GuideFound</bpmn:incoming>
      <bpmn:incoming>Flow_ManualGuideAssigned</bpmn:incoming>
      <bpmn:outgoing>Flow_AllocateToRequest</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sendTask id="SendTask_SendAllocationRequest" name="Send Guide Allocation Request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-allocation-request" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AllocateToRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_RequestToReceive</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Step 10: Guide Acceptance / Decline (Failure Path F9) -->
    <bpmn:userTask id="UserTask_GuideResponse" name="Guide Accept / Decline Allocation Request (F9)">
      <bpmn:incoming>Flow_RequestToReceive</bpmn:incoming>
      <bpmn:outgoing>Flow_GuideAccepted</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="BoundaryTimer_GuideResponseTimeout" name="5-Day Response SLA" attachedToRef="UserTask_GuideResponse">
      <bpmn:outgoing>Flow_GuideTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_5Days">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <!-- Sub-process & Failure Path F11: Allocation Finalization -->
    <bpmn:subProcess id="SubProcess_AllocationFinalization" name="Allocation Finalization Sub-process (F11)">
      <bpmn:incoming>Flow_GuideAccepted</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalizationToNotify</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Step 11: Notify Student & Complete -->
    <bpmn:sendTask id="SendTask_NotifyStudentAndRecord" name="Notify Student &amp; Record Allocation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-student" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FinalizationToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyToDone</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_ProjectAllocated" name="End: Project Successfully Allocated">
      <bpmn:incoming>Flow_NotifyToDone</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartToValidate" sourceRef="StartEvent_ProposalSubmitted" targetRef="ServiceTask_ValidateFormAndRules" />
    <bpmn:sequenceFlow id="Flow_ResubmitToValidate" sourceRef="UserTask_ResubmitProposal" targetRef="ServiceTask_ValidateFormAndRules" />
    <bpmn:sequenceFlow id="Flow_ValidateToGateway" sourceRef="ServiceTask_ValidateFormAndRules" targetRef="Gateway_ValidationPassed" />
    <bpmn:sequenceFlow id="Flow_ValidationYes" name="Yes" sourceRef="Gateway_ValidationPassed" targetRef="ServiceTask_CheckDuplicateTopic" />
    <bpmn:sequenceFlow id="Flow_ValidationNo" name="No" sourceRef="Gateway_ValidationPassed" targetRef="Gateway_ValidationAttempts" />
    <bpmn:sequenceFlow id="Flow_AttemptUnderLimit" name="Attempt &lt;= 2" sourceRef="Gateway_ValidationAttempts" targetRef="UserTask_ResubmitProposal" />
    <bpmn:sequenceFlow id="Flow_AttemptExceeded" name="Attempt &gt; 2" sourceRef="Gateway_ValidationAttempts" targetRef="EndEvent_InvalidTeam" />
    <bpmn:sequenceFlow id="Flow_CheckToGateway" sourceRef="ServiceTask_CheckDuplicateTopic" targetRef="Gateway_DuplicateCheck" />
    <bpmn:sequenceFlow id="Flow_PlagiarismNo" name="No" sourceRef="Gateway_DuplicateCheck" targetRef="UserTask_ScreenProposal" />
    <bpmn:sequenceFlow id="Flow_PlagiarismYes" name="Yes" sourceRef="Gateway_DuplicateCheck" targetRef="UserTask_ReviewPlagiarismMatch" />
    <bpmn:sequenceFlow id="Flow_MatchToDecision" sourceRef="UserTask_ReviewPlagiarismMatch" targetRef="UserTask_ModifyTopic" />
    <bpmn:sequenceFlow id="Flow_TopicModifiedToScreen" sourceRef="UserTask_ModifyTopic" targetRef="UserTask_ScreenProposal" />
    <bpmn:sequenceFlow id="Flow_PlagiarismReject" name="Reject" sourceRef="UserTask_ReviewPlagiarismMatch" targetRef="EndEvent_RejectedPlagiarism" />
    <bpmn:sequenceFlow id="Flow_ScreenToCommittee" sourceRef="UserTask_ScreenProposal" targetRef="UserTask_EvaluateProposal" />
    <bpmn:sequenceFlow id="Flow_EvaluateToGateway" sourceRef="UserTask_EvaluateProposal" targetRef="Gateway_CommitteeDecision" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Approve" sourceRef="Gateway_CommitteeDecision" targetRef="BusinessRuleTask_CheckGuideAvailability" />
    <bpmn:sequenceFlow id="Flow_Revise" name="Revise" sourceRef="Gateway_CommitteeDecision" targetRef="SubProcess_RevisionLoop" />
    <bpmn:sequenceFlow id="Flow_RejectCommittee" name="Reject" sourceRef="Gateway_CommitteeDecision" targetRef="EndEvent_RejectedCommittee" />
    <bpmn:sequenceFlow id="Flow_RevisionCompleted" sourceRef="SubProcess_RevisionLoop" targetRef="BusinessRuleTask_CheckGuideAvailability" />
    <bpmn:sequenceFlow id="Flow_RuleToGateway" sourceRef="BusinessRuleTask_CheckGuideAvailability" targetRef="Gateway_GuideAvailable" />
    <bpmn:sequenceFlow id="Flow_GuideFound" name="Yes" sourceRef="Gateway_GuideAvailable" targetRef="ServiceTask_AllocateGuide" />
    <bpmn:sequenceFlow id="Flow_GuideNone" name="None" sourceRef="Gateway_GuideAvailable" targetRef="UserTask_ManualGuideAllocation" />
    <bpmn:sequenceFlow id="Flow_ManualGuideAssigned" sourceRef="UserTask_ManualGuideAllocation" targetRef="ServiceTask_AllocateGuide" />
    <bpmn:sequenceFlow id="Flow_AllocateToRequest" sourceRef="ServiceTask_AllocateGuide" targetRef="SendTask_SendAllocationRequest" />
    <bpmn:sequenceFlow id="Flow_RequestToReceive" sourceRef="SendTask_SendAllocationRequest" targetRef="UserTask_GuideResponse" />
    <bpmn:sequenceFlow id="Flow_GuideAccepted" name="Accepted" sourceRef="UserTask_GuideResponse" targetRef="SubProcess_AllocationFinalization" />
    <bpmn:sequenceFlow id="Flow_GuideTimeout" sourceRef="BoundaryTimer_GuideResponseTimeout" targetRef="UserTask_ManualGuideAllocation" />
    <bpmn:sequenceFlow id="Flow_FinalizationToNotify" sourceRef="SubProcess_AllocationFinalization" targetRef="SendTask_NotifyStudentAndRecord" />
    <bpmn:sequenceFlow id="Flow_NotifyToDone" sourceRef="SendTask_NotifyStudentAndRecord" targetRef="EndEvent_ProjectAllocated" />

  </bpmn:process>

  <bpmn:error id="Error_InvalidTeam" name="ERR_INVALID_TEAM" errorCode="ERR_INVALID_TEAM" />

  <!-- Diagram Interchange Coordinates and Visual Edges -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_StudentProject">
    <bpmndi:BPMNPlane id="BPMNPlane_StudentProject" bpmnElement="Collaboration_StudentProject">
      
      <bpmndi:BPMNShape id="Participant_StudentProjectProcess_di" bpmnElement="Participant_StudentProjectProcess" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1700" height="980" />
      </bpmndi:BPMNShape>
      
      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_Student_di" bpmnElement="Lane_Student" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1670" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Coordinator_di" bpmnElement="Lane_Coordinator" isHorizontal="true">
        <dc:Bounds x="190" y="280" width="1670" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Committee_di" bpmnElement="Lane_Committee" isHorizontal="true">
        <dc:Bounds x="190" y="470" width="1670" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Guide_di" bpmnElement="Lane_Guide" isHorizontal="true">
        <dc:Bounds x="190" y="690" width="1670" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="190" y="860" width="1670" height="200" />
      </bpmndi:BPMNShape>

      <!-- Shapes -->
      <bpmndi:BPMNShape id="StartEvent_ProposalSubmitted_di" bpmnElement="StartEvent_ProposalSubmitted">
        <dc:Bounds x="242" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="221" y="195" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_ValidateFormAndRules_di" bpmnElement="ServiceTask_ValidateFormAndRules">
        <dc:Bounds x="230" y="910" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ValidationPassed_di" bpmnElement="Gateway_ValidationPassed" isMarkerVisible="true">
        <dc:Bounds x="385" y="925" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="386" y="982" width="49" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ValidationAttempts_di" bpmnElement="Gateway_ValidationAttempts" isMarkerVisible="true">
        <dc:Bounds x="385" y="850" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="300" y="865" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ResubmitProposal_di" bpmnElement="UserTask_ResubmitProposal">
        <dc:Bounds x="360" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_InvalidTeam_di" bpmnElement="EndEvent_InvalidTeam">
        <dc:Bounds x="512" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="490" y="195" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_CheckDuplicateTopic_di" bpmnElement="ServiceTask_CheckDuplicateTopic">
        <dc:Bounds x="490" y="910" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DuplicateCheck_di" bpmnElement="Gateway_DuplicateCheck" isMarkerVisible="true">
        <dc:Bounds x="645" y="925" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="630" y="982" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ReviewPlagiarismMatch_di" bpmnElement="UserTask_ReviewPlagiarismMatch">
        <dc:Bounds x="620" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ModifyTopic_di" bpmnElement="UserTask_ModifyTopic">
        <dc:Bounds x="620" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_RejectedPlagiarism_di" bpmnElement="EndEvent_RejectedPlagiarism">
        <dc:Bounds x="772" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="750" y="195" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ScreenProposal_di" bpmnElement="UserTask_ScreenProposal">
        <dc:Bounds x="740" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_EvaluateProposal_di" bpmnElement="UserTask_EvaluateProposal">
        <dc:Bounds x="890" y="530" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CommitteeDecision_di" bpmnElement="Gateway_CommitteeDecision" isMarkerVisible="true">
        <dc:Bounds x="1045" y="545" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1040" y="602" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_RevisionLoop_di" bpmnElement="SubProcess_RevisionLoop" isExpanded="false">
        <dc:Bounds x="1020" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_RejectedCommittee_di" bpmnElement="EndEvent_RejectedCommittee">
        <dc:Bounds x="1052" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1030" y="195" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BusinessRuleTask_CheckGuideAvailability_di" bpmnElement="BusinessRuleTask_CheckGuideAvailability">
        <dc:Bounds x="1160" y="910" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_GuideAvailable_di" bpmnElement="Gateway_GuideAvailable" isMarkerVisible="true">
        <dc:Bounds x="1315" y="925" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1300" y="982" width="80" height="27" />
        </bpmndi:BPMNLabel>
